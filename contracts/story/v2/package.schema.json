{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "format": {
      "const": "chronolatvia-interactive-story"
    },
    "formatVersion": {
      "const": 2
    },
    "storyId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "graphRevision": {
      "type": "integer",
      "minimum": 1
    },
    "engineVersion": {
      "const": "2.0.0"
    },
    "entryNodeId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "language": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "contentType": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "sha256",
          "bytes",
          "contentType"
        ],
        "additionalProperties": false
      }
    },
    "contentHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "playable": {
      "type": "boolean"
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    }
  },
  "required": [
    "format",
    "formatVersion",
    "storyId",
    "graphRevision",
    "engineVersion",
    "entryNodeId",
    "language",
    "title",
    "files",
    "contentHash",
    "playable",
    "languages"
  ],
  "additionalProperties": false
}
